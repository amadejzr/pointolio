  "fixed_sql": [
    {
      "name": "game_types",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"game_types\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"lowest_score_wins\" INTEGER NOT NULL DEFAULT 0 CHECK (\"lowest_score_wins\" IN (0, 1)), \"color\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"name\"));"
        }
      ]
    },
    {
      "name": "games",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"games\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"game_date\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"game_type_id\" INTEGER NULL REFERENCES game_types (id) ON DELETE SET NULL, \"game_type_name_snapshot\" TEXT NULL, \"note\" TEXT NULL, \"finished_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "players",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"players\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"first_name\" TEXT NOT NULL, \"last_name\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"color\" INTEGER NULL, UNIQUE (\"first_name\", \"last_name\"));"
        }
      ]
    },
    {
      "name": "game_players",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"game_players\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"game_id\" INTEGER NOT NULL REFERENCES games (id) ON DELETE CASCADE, \"player_id\" INTEGER NOT NULL REFERENCES players (id) ON DELETE RESTRICT, \"order_index\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"game_id\", \"player_id\"));"
        }
      ]
    },
    {
      "name": "score_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"score_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"game_player_id\" INTEGER NOT NULL REFERENCES game_players (id) ON DELETE CASCADE, \"round_number\" INTEGER NOT NULL, \"points\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"game_player_id\", \"round_number\"));"
        }
      ]
    }
  ]
